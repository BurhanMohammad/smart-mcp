# REPO_PATH — which project smart-mcp should index.
#
# Resolution order (highest to lowest priority):
#   1. CLI argument  — python -m app.mcp.server C:\Work\MyProject
#   2. This env var  — uncomment and set below
#   3. Auto-detect   — the working directory when Claude / the MCP host starts
#                      (use setup_project.py to wire this up per project)
#
# Uncomment the line below to hard-code a single project:
REPO_PATH=C:\Work\NatFirstAPI
